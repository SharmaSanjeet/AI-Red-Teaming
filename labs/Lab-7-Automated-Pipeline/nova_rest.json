{
  "rest": {
    "RestGenerator": {
      "name": "nova-local",
      "uri": "http://localhost:8000/chat",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "message": "$INPUT",
        "user_id": "2001"
      },
      "response_json": true,
      "response_json_field": "reply",
      "request_timeout": 60
    }
  }
}
